{
  "name": "research-claw",
  "version": "0.8.1",
  "description": "Research-Claw (科研龙虾) — AI-powered local academic research assistant, built as an OpenClaw satellite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "prepare": "node scripts/prepare-package-manager.cjs",
    "start": "bash scripts/run.sh",
    "dev": "RC_LOG_PROFILE=developer concurrently \"pnpm --filter dashboard dev\" \"bash scripts/run.sh\"",
    "build": "pnpm build:extensions && pnpm build:dashboard",
    "build:dashboard": "pnpm --filter dashboard build",
    "build:extensions": "pnpm --filter './extensions/*' build",
    "test": "vitest run && pnpm --filter dashboard test",
    "test:root": "vitest run",
    "test:watch": "vitest",
    "verify:e2e": "node scripts/verify-dashboard-version-gate.mjs && node scripts/verify-rpc-error-classification.mjs && node scripts/verify-runtime-self-check.mjs && node scripts/verify-cron-deadline-fallback.mjs",
    "verify:docker": "node scripts/verify-docker-config.mjs",
    "verify:logging": "node scripts/verify-log-levels.mjs",
    "verify:installers": "node scripts/verify-installer-copies.mjs --public-url https://wentor.ai/install.sh",
    "setup": "bash scripts/setup.sh",
    "health": "bash scripts/health.sh",
    "backup": "bash scripts/backup.sh",
    "serve": "bash scripts/run.sh",
    "serve:user": "RC_LOG_PROFILE=user bash scripts/run.sh",
    "serve:developer": "RC_LOG_PROFILE=developer bash scripts/run.sh",
    "support": "RC_LOG_PROFILE=support bash scripts/run.sh",
    "sync-upstream": "bash scripts/sync-upstream.sh"
  },
  "dependencies": {
    "openclaw": "2026.6.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "openclaw@2026.6.1": "patches/openclaw@2026.6.1.patch"
    },
    "overrides": {
      "sass-embedded": "npm:sass@^1.77.0",
      "@hono/node-server@<1.19.13": "1.19.13",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion@>=2.0.0 <5.0.8": "5.0.8",
      "fast-uri@>=3.0.0 <3.1.4": "3.1.4",
      "hono@>=4.0.0 <4.12.27": "4.12.27",
      "ip-address@>=10.0.0 <=10.1.0": "10.1.1",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "protobufjs@>=7.0.0 <=7.6.2": "7.6.5",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "undici@>=8.0.0 <8.5.0": "8.5.0",
      "yaml@>=1.0.0 <1.10.3": "1.10.3"
    },
    "onlyBuiltDependencies": [
      "@google/genai",
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "openclaw",
      "protobufjs",
      "tree-sitter-bash"
    ]
  }
}
