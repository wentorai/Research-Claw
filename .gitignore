# Dependencies
node_modules/

# Build output
dist/
build/
dashboard/dist/
*.tsbuildinfo
*.d.ts.map

# Runtime config (use openclaw.example.json as template)
# Any openclaw.json snapshot/backup variant may contain plaintext secrets — never commit.
# Catch-all covers .bak, .bak.N, .last-good, .prefix-<timestamp>, etc.; example template is unaffected.
config/openclaw.json
config/openclaw.json.*
config/.openclaw.json.*.tmp
config/.openclaw.json.ensure-config-intent.json
config/.openclaw.json.ensure-config-intent.staging
config/.rc-bootstrap-live-config-*.tmp
config/*.bak
config/*.bak.*
config/*.prefix-*
config/openclaw.json.last-good
# Bootstrap lock authority and multi-volume transaction journals are durable
# private runtime state. They can contain credential preimages and must survive
# installer `git clean -fd` across upgrades.
config/.rc-bootstrap/
config/.rc-bootstrap-lock-authority/

# Browser/runtime data written under config/ at runtime — never commit.
# These can contain cookies, login data and other private/credential material.
config/browser/
config/media/
config/npm/
config/plugin-skills/

# Environment
.env
.env.local
.env.production

# Windows acceptance material. Concrete manifests can contain deployment
# provenance and the secret bundle contains live staging credentials. Keep only
# the checked-in example/schema; every operator-created instance stays local.
/scripts/acceptance/windows-bootstrap-docker.manifest*.json
!/scripts/acceptance/windows-bootstrap-docker.manifest.example.json
/scripts/acceptance/windows-bootstrap-docker.secret-bundle*.json
!/scripts/acceptance/windows-bootstrap-docker.secret-bundle.schema.json
/scripts/acceptance/windows-bootstrap-docker.evidence*/

# SQLite databases (both .sqlite and .db patterns)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
.research-claw/
.research-claw-install.json

# OS
.DS_Store
Thumbs.db

# Claude Code worktrees
.claude/worktrees/

# Claude Code local settings
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Temp
.tmp/
.tools/
dashboard/test-image-send.mjs

# Lock files (using pnpm, not npm)
extensions/*/package-lock.json

# Extension script caches (runtime API-response caches, regenerated on demand)
extensions/*/scripts/.cache/

# Workspace runtime data
# research-claw-core can create its own nested runtime workspace repository.
# It is local state, not an OpenClaw submodule.
/extensions/research-claw-core/workspace/

# All prompt files live in workspace/.ResearchClaw/ (loaded via agent:bootstrap hook).
# Root-level copies (AGENTS.md, HEARTBEAT.md) are synced by run.sh for OC compatibility
# but must not be tracked — .ResearchClaw/ versions are the source of truth.
workspace/*
!workspace/.gitignore
!workspace/.ResearchClaw/
!workspace/MEMORY.md.example
!workspace/USER.md.example
workspace/SOUL.md
workspace/IDENTITY.md
workspace/TOOLS.md
workspace/HEARTBEAT.md
workspace/USER.md
workspace/MEMORY.md
workspace/.ResearchClaw/SOUL.md
workspace/.ResearchClaw/IDENTITY.md
workspace/.ResearchClaw/TOOLS.md
workspace/.ResearchClaw/USER.md
workspace/.ResearchClaw/BOOTSTRAP.md
workspace/.ResearchClaw/BOOTSTRAP.md.done
workspace/.ResearchClaw/*_backup_*.md
workspace/.openclaw/
workspace/memory/
workspace/sources/
workspace/skills_collection/
workspace/outputs/
workspace/workspace/
workspace/*.csv
workspace/*.bib
workspace/*.json
workspace/*.py
workspace/*.ipynb
workspace/*.txt
workspace/helloworld.md
workspace/test-scenarios.md
workspace/*_report*.md
workspace/ml-project/

# eval 本地密钥(绝不提交)
eval/.secrets.local.json
