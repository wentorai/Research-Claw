{
  "env": {
    "vars": {
      "UNPAYWALL_EMAIL": "research@wentor.ai"
    }
  },
  "logging": {
    "level": "info",
    "consoleLevel": "warn",
    "file": "~/.research-claw/logs/openclaw.log"
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    },
    "wideArea": {
      "enabled": false
    }
  },
  "ui": {
    "assistant": {
      "name": "Research-Claw"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "skipBootstrap": true,
      "timeoutSeconds": 3600,
      "compaction": {
        "mode": "safeguard",
        "customInstructions": "Research-Claw scientific-fidelity requirements for the compaction summary:\nPreserve exact facts and qualifiers:\n1. Research questions/goals, hypotheses, scope, user constraints.\n2. Observations, experimental/negative results, conflicting evidence.\n3. Numbers with units, uncertainty/error, sample sizes, statistics, experimental conditions, time ranges.\n4. Methods/design, datasets and versions, parameters, environment, reproduction steps.\n5. Citations/IDs: DOIs, URLs, file paths, commit hashes.\n6. Decisions with rationale, unresolved questions, next steps, and blockers.\n7. Evidence status: observations, inferences, hypotheses, plans; never turn uncertainty into fact.\nRemove greetings, repetition, and process noise; do not drop conditions or qualifiers needed for scientific conclusions."
      },
      "thinkingDefault": "medium",
      "subagents": {
        "announceTimeoutMs": 480000
      },
      "heartbeat": {
        "every": "30m",
        "lightContext": true,
        "isolatedSession": true
      },
      "sandbox": {
        "mode": "off"
      }
    }
  },
  "browser": {
    "enabled": true,
    "defaultProfile": "research-claw",
    "profiles": {
      "research-claw": {
        "cdpPort": 18800,
        "color": "#EF4444"
      }
    }
  },
  "gateway": {
    "port": 28789,
    "mode": "local",
    "bind": "loopback",
    "controlUi": {
      "root": "./dashboard/dist",
      "allowedOrigins": [
        "http://127.0.0.1:28789",
        "http://localhost:28789",
        "http://127.0.0.1:5175",
        "http://localhost:5175"
      ],
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "none"
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "./skills",
        "./workspace/skills"
      ]
    },
    "workshop": {
      "autonomous": {
        "enabled": false
      },
      "approvalPolicy": "pending",
      "maxPending": 50,
      "maxSkillBytes": 40000
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "browser",
      "research-claw-core",
      "research-plugins",
      "openclaw-weixin",
      "dual-model-supervisor",
      "research-superpower"
    ],
    "load": {
      "paths": [
        "./extensions/research-claw-core",
        "./extensions/openclaw-weixin",
        "./extensions/dual-model-supervisor",
        "./extensions/research-superpower"
      ]
    },
    "entries": {
      "research-claw-core": {
        "enabled": true,
        "config": {
          "dbPath": "~/.research-claw/library.db",
          "autoTrackGit": true,
          "defaultCitationStyle": "apa",
          "heartbeatDeadlineWarningHours": 48,
          "pptRoot": "integrations/ppt-master"
        }
      },
      "openclaw-weixin": {
        "enabled": true
      },
      "dual-model-supervisor": {
        "enabled": true,
        "config": {
          "enabled": false,
          "supervisorModel": "",
          "reviewMode": "off",
          "memoryGuard": {
            "enabled": true,
            "keyCategories": [
              "research_goal",
              "key_conclusion",
              "user_preference",
              "methodology_decision"
            ]
          },
          "courseCorrection": {
            "enabled": true,
            "deviationThreshold": 0.5,
            "forceRegenerate": false,
            "maxRegenerateAttempts": 3
          },
          "highRiskTools": [
            "exec",
            "write",
            "edit",
            "send_notification",
            "browser"
          ]
        }
      },
      "research-superpower": {
        "enabled": true
      }
    }
  },
  "tools": {
    "profile": "full"
  }
}
