{
  "env": {
    "vars": {
      "UNPAYWALL_EMAIL": "research@wentor.ai"
    }
  },
  "logging": {
    "level": "info",
    "consoleLevel": "error",
    "file": "~/.research-claw/logs/openclaw.log",
    "redactPatterns": [
      "\\b(?:Cookie|Set-Cookie)\\s*:\\s*([^\\r\\n]+)",
      "https?://hooks\\.[^/\\s]+/(?:services/)?([^\\s\"'<>]+)",
      "https?://[^\\s\"'<>]+/(?:api/)?webhooks?/([^\\s\"'<>]+)",
      "https?://open\\.feishu\\.cn/open-apis/bot/v2/hook/([^\\s\"'<>]+)",
      "[a-z][a-z0-9+.-]*://[^@\\s/:]+:([^@\\s]+)@"
    ]
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "agents": {
    "entries": {
      "main": {
        "identity": {
          "name": "Research-Claw"
        }
      }
    },
    "defaults": {
      "workspace": "./workspace",
      "skipBootstrap": true,
      "bootstrapMaxChars": 30000,
      "timeoutSeconds": 3600,
      "compaction": {
        "mode": "safeguard"
      },
      "thinkingDefault": "medium",
      "subagents": {
        "announceTimeoutMs": 480000
      },
      "heartbeat": {
        "every": "30m",
        "lightContext": true,
        "isolatedSession": true
      },
      "sandbox": {
        "mode": "off"
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false
    }
  },
  "browser": {
    "enabled": true,
    "defaultProfile": "research-claw",
    "profiles": {
      "research-claw": {
        "cdpPort": 18800
      }
    }
  },
  "gateway": {
    "port": 28789,
    "mode": "local",
    "bind": "loopback",
    "controlUi": {
      "root": "./dashboard/dist",
      "allowedOrigins": [
        "http://127.0.0.1:28789",
        "http://localhost:28789",
        "http://127.0.0.1:5175",
        "http://localhost:5175"
      ],
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "none"
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "./skills"
      ]
    },
    "limits": {
      "maxSkillsInPrompt": 100,
      "maxSkillsPromptChars": 26000
    },
    "install": {
      "allowUploadedArchives": true
    },
    "workshop": {
      "autonomous": {
        "mode": "off"
      },
      "approvalPolicy": "pending",
      "maxPending": 50,
      "maxSkillBytes": 40000
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "browser",
      "research-claw-core",
      "research-plugins",
      "openclaw-weixin",
      "dual-model-supervisor",
      "research-superpower"
    ],
    "load": {
      "paths": [
        "./extensions/research-claw-core",
        "./extensions/openclaw-weixin",
        "./extensions/dual-model-supervisor",
        "./extensions/research-superpower"
      ]
    },
    "entries": {
      "research-claw-core": {
        "enabled": true,
        "config": {
          "dbPath": "~/.research-claw/library.db",
          "autoTrackGit": true,
          "defaultCitationStyle": "apa",
          "heartbeatDeadlineWarningHours": 48,
          "pptRoot": "integrations/ppt-master",
          "productPolicy": {
            "capabilities": {
              "settings": "enabled",
              "extensions": "enabled",
              "supervisor": "enabled",
              "peripherals": "enabled"
            }
          }
        }
      },
      "openclaw-weixin": {
        "enabled": true
      },
      "dual-model-supervisor": {
        "enabled": true,
        "llm": {
          "allowModelOverride": true
        },
        "config": {
          "enabled": false,
          "supervisorModel": "",
          "reviewMode": "off",
          "courseCorrection": {
            "enabled": true,
            "deviationThreshold": 0.5,
            "forceRegenerate": false,
            "maxRegenerateAttempts": 3
          },
          "highRiskTools": [
            "exec",
            "write",
            "edit",
            "send_notification",
            "browser"
          ]
        }
      },
      "research-superpower": {
        "enabled": true
      }
    }
  },
  "tools": {
    "profile": "full",
    "toolSearch": false
  }
}
