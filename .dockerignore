# Dependencies — reinstalled fresh in image
node_modules
**/node_modules

# Build outputs — rebuilt in image
dashboard/dist
extensions/*/dist
**/*.tsbuildinfo
**/*.d.ts.map

# ppt-master is a populated git submodule in release checkouts. Ship only its
# runtime skill, never its nested .git history, docs, examples, or local projects.
ppt-master/**
!ppt-master/skills/
!ppt-master/skills/ppt-master/
!ppt-master/skills/ppt-master/**

# User config — deny by default; only the release template enters the image.
config/**
!config/openclaw.example.json
!config/research-compaction-instructions.txt

# User data — volume-mounted at runtime
.research-claw
workspace/**
!workspace/.ResearchClaw/
workspace/.ResearchClaw/**
!workspace/.ResearchClaw/AGENTS.md
!workspace/.ResearchClaw/HEARTBEAT.md
!workspace/.ResearchClaw/SOUL.md.example
!workspace/.ResearchClaw/IDENTITY.md.example
!workspace/.ResearchClaw/TOOLS.md.example
!workspace/.ResearchClaw/BOOTSTRAP.md.example
!workspace/.ResearchClaw/USER.md.example
!workspace/MEMORY.md.example

# Git
.git
.gitignore
.github/

# Secrets / env
.env

# Bootstrap Capsules are private issuer inputs and never runtime image assets.
profiles/

# Generated evaluation runs are development evidence, not runtime image assets.
eval/artifacts/
eval/.run/

# Misc
*.log
test/
tests/
**/__tests__/
**/__fixtures__/
**/*.test.*
**/*.spec.*

# Local integration harness: depends on test-only provider fixtures and must
# never be shipped as an incomplete runtime script.
scripts/probe-bootstrap-profile-e2e.mjs
scripts/verify-installer-powershell.ps1
scripts/verify-updater-powershell.ps1
scripts/verify-log-levels.mjs
scripts/build-profile-capsule.mjs
scripts/validate-profile-pack.mjs
scripts/acceptance/
