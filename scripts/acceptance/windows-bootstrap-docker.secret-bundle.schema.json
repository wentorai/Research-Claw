{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wentor.ai/schemas/acceptance/windows-bootstrap-docker-secret-bundle-v1.json",
  "title": "Research-Claw Windows Bootstrap acceptance secret bundle",
  "description": "Value-free schema for an operator-supplied, ACL-private T10 fixture bundle. All eleven values must also be pairwise distinct; the acceptance harness enforces that cross-field invariant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tokens", "modelKeys"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "unknown",
        "revoked",
        "badCapsule",
        "valid",
        "rotate",
        "healthFail"
      ],
      "properties": {
        "network": { "$ref": "#/$defs/token" },
        "unknown": { "$ref": "#/$defs/token" },
        "revoked": { "$ref": "#/$defs/token" },
        "badCapsule": { "$ref": "#/$defs/token" },
        "valid": { "$ref": "#/$defs/token" },
        "rotate": { "$ref": "#/$defs/token" },
        "healthFail": { "$ref": "#/$defs/token" }
      }
    },
    "modelKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["badCapsule", "valid", "rotate", "healthFail"],
      "properties": {
        "badCapsule": { "$ref": "#/$defs/modelKey" },
        "valid": { "$ref": "#/$defs/modelKey" },
        "rotate": { "$ref": "#/$defs/modelKey" },
        "healthFail": { "$ref": "#/$defs/modelKey" }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^rca_[A-Za-z0-9_-]{43,}$"
    },
    "modelKey": {
      "description": "T10 fixture-only printable ASCII key. Quote and backslash are excluded so raw-volume occurrence counts remain exact.",
      "type": "string",
      "minLength": 16,
      "maxLength": 16384,
      "pattern": "^[\\x21\\x23-\\x5B\\x5D-\\x7E]+$"
    }
  }
}
